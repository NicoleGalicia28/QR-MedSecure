# App
NODE_ENV=development
PORT=5000
API_PREFIX=/api
CORS_ORIGIN=http://localhost:5173

# JWT
JWT_SECRET=change_this_to_a_long_random_256bit_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# AES-256-GCM for QR
QR_ENCRYPTION_KEY=base64_32byte_or_hex_32byte_key

# MySQL (online)
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=qr_medsecure
DB_USER=root
DB_PASS=your_password

# SQLite (offline)
SQLITE_PATH=./data/offline.db

# Sync
ENABLE_OFFLINE_SYNC=true
